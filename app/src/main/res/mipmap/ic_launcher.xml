<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon for Android 7 (minSdk 24), which cannot read an adaptive icon (P3-62). The
     foreground is enlarged by the negative insets so it fills the circle as the adaptive icon's
     visible 72 of 108 dp does. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:bottom="-12dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="-12dp"
        android:right="-12dp"
        android:top="-12dp" />
</layer-list>
