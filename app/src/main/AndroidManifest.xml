<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Health Connect read permissions - DECISIONS.md P3-11.

        Read-only, and exactly the three metrics P3-11 pins. No write permission
        is declared or requested, which is what keeps P3-3's "read-only context"
        true by construction rather than by intention. Each is granted
        individually by the user, and the read path treats any of them being
        withheld as an ordinary result rather than an error.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!--
        Camera capture for live analysis - DECISIONS.md P3-13.

        A runtime permission, requested when the live screen opens and refused
        without consequence for the rest of the app: the dashboard, history and
        exercise library all work without it. No audio is recorded and no video
        is stored - CLAUDE.md section 16 forbids storing user video as part of
        normal operation, and nothing here writes a frame anywhere.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        The Health Connect client library declares minSdk 26; Kinesis supports 24.

        Overriding rather than raising the app's minSdk is deliberate, and
        DECISIONS.md P3-11 records why: Health Connect is supplementary context
        (P3-3, "displayed alongside Kinesis's own measurements rather than
        replacing them"), and raising the floor for every user to gain an
        optional panel is backwards. The merger warns this "may lead to runtime
        failures" - that risk is what HealthConnectActivityContextSource's
        Build.VERSION.SDK_INT guard and @RequiresApi(26) annotations exist to
        remove. Below API 26 no Health Connect class is ever loaded and the read
        path returns PLATFORM_TOO_OLD, which is a tested case.
    -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <application
        android:allowBackup="true"
        android:label="Kinesis"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!--
            configChanges: the live screen locks itself to portrait (DECISIONS.md
            P3-16). Without this the lock would recreate the activity, and the
            navigation state - held in Compose, not saved - would reset to the
            dashboard mid-set. Compose re-lays itself out on the change anyway.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Why Kinesis asks for Health Connect data - DECISIONS.md P3-19. Health
            Connect only shows its permission dialog to an app that declares where
            it explains its use: this activity before Android 14, and the alias
            below from Android 14, where Health Connect is part of the platform.
            Without them the request returns at once and no dialog appears.
        -->
        <activity
            android:name=".health.HealthPermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".health.HealthPermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
            Session export - P5, CLAUDE.md section 15. Lets the share sheet read
            the files the user just asked to export, and nothing else: its only
            path is cache/exports/ (res/xml/export_paths.xml). Not exported, so
            no other app can reach it except through a one-off read grant on a
            file the user chose to share. It declares no permission and gives
            the app no network capability.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
    </application>

</manifest>
